#!/usr/bin/env bash
# AIBOM Inspector launcher — one command, no Docker flags to remember.
#
#   ./aibom                     guided menu
#   ./aibom ui                  web UI at http://localhost:8000
#   ./aibom demo                offline blast-radius + drift demo
#   ./aibom scan .              scan this directory
#   ./aibom scan https://…      scan a public repo URL
#   ./aibom diff old/ new/      behavioral drift between two revisions
#
# Local paths are mounted read-only and rewritten automatically; reports land
# in ./aibom-out. Anything not listed above is passed straight to the CLI.
set -euo pipefail

IMAGE="${AIBOM_IMAGE:-aibom-inspector}"
PORT="${AIBOM_PORT:-8000}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK="$(pwd -P)"
OUT="$WORK/aibom-out"

# Git Bash / MSYS rewrites POSIX-looking arguments into Windows paths, which
# turns `-w /work` into `C:/Program Files/Git/work`. Disable that translation
# for the docker invocations; the variables are inert on Linux and macOS.
MSYS_ENV="MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL=*"

die() { printf '\033[31merror:\033[0m %s\n' "$1" >&2; exit 2; }

require_docker() {
  command -v docker >/dev/null 2>&1 ||
    die "Docker is not installed. Install Docker Desktop, or run 'pip install -e .' and use 'aibom' directly."
  docker info >/dev/null 2>&1 ||
    die "the Docker daemon is not responding. Start Docker Desktop, wait for it to report ready, then rerun."
}

ensure_image() {
  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    printf 'Building the %s image (first run only)…\n' "$IMAGE" >&2
    docker build -t "$IMAGE" "$HERE" >&2
  fi
}

# Rewrite an existing host path into its mounted location inside the container.
# Anything else (URL, flag, plain value) is passed through untouched.
map_arg() {
  local arg="$1"
  case "$arg" in
    -*|*://*) printf '%s' "$arg"; return ;;
  esac
  [ -e "$arg" ] || { printf '%s' "$arg"; return; }
  local abs
  if [ -d "$arg" ]; then
    abs="$(cd "$arg" && pwd -P)"
  else
    abs="$(cd "$(dirname "$arg")" && pwd -P)/$(basename "$arg")"
  fi
  case "$abs" in
    "$WORK") printf '/work' ;;
    "$WORK"/*) printf '/work/%s' "${abs#"$WORK"/}" ;;
    *) die "'$arg' is outside $WORK. cd to a directory that contains it, then rerun." ;;
  esac
}

# Only ask docker for a TTY when we actually have one, so the launcher works
# from CI, a pipe, or a background job as well as from a terminal.
tty_flags() {
  if [ -t 0 ] && [ -t 1 ]; then printf -- '-it'; fi
}

run_cli() {
  mkdir -p "$OUT"
  local mapped=()
  local arg
  for arg in "$@"; do mapped+=("$(map_arg "$arg")"); done
  local tty=()
  [ -n "$(tty_flags)" ] && tty=(-it)
  exec env $MSYS_ENV docker run --rm "${tty[@]}" \
    -v "$WORK:/work:ro" \
    -v "$OUT:/out" \
    -w /work \
    "$IMAGE" aibom "${mapped[@]}"
}

require_docker
ensure_image

case "${1-}" in
  ui|serve|web)
    printf 'AIBOM Inspector UI → http://localhost:%s   (Ctrl-C to stop)\n' "$PORT"
    ui_tty=()
    [ -n "$(tty_flags)" ] && ui_tty=(-t)
    exec env $MSYS_ENV docker run --rm "${ui_tty[@]}" \
      -p "$PORT:8000" -e "AIBOM_PORT=$PORT" "$IMAGE"
    ;;
  -h|--help|help)
    sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    printf '\nFull CLI reference:\n'
    run_cli --help
    ;;
  *)
    run_cli "$@"
    ;;
esac
